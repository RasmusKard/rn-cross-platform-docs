  "author": "Rasmus Kard <rasmuskard@gmail.com> (https://github.com/RasmusKard)",
  "license": "MIT",
  "homepage": "https://github.com/RasmusKard/rn-cross-platform-docs#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.88.1",
    "@rn-cross-platform-docs/zensical": "file:../../plugins/zensical",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^58.0.21",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "prettier": "^3.0.0",
