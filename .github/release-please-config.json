{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "release-as": "1.0.0",
      "extra-files": [
        { "type": "json", "path": "plugins/zensical/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugins/zensical/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugins/zensical/package-lock.json", "jsonpath": "$.packages[''].version" }
      ]
    }
  }
}
