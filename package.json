{
  "name": "@rn-cross-platform-docs/cli",
  "version": "0.0.0",
  "description": "Markdown API reference for React Native native modules, one tree per platform: TypeScript, Kotlin and Swift",
  "license": "MIT",
  "repository": "https://github.com/RasmusKard/rn-cross-platform-docs",
  "type": "module",
  "bin": {
    "rn-cross-platform-docs": "dist/cli.js"
  },
  "exports": {},
  "files": [
    "dist",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test 'test/**/*.test.ts'",
    "lint": "oxlint && tsc --noEmit && oxfmt --check",
    "format": "oxfmt"
  },
  "peerDependencies": {
    "typedoc": "0.28.x",
    "typedoc-plugin-markdown": "4.14.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "markdown-it": "15.0.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "6.0.3"
  }
}
